      "lesson": {
        "vocabulary": [
          {
            "term": "Tapón lila / morado",
            "translation": "EDTA → hemograma (biometría hemática)."
          },
          {
            "term": "Tapón celeste",
            "translation": "Citrato de sodio → pruebas de coagulación (TP, TTP)."
          },
          {
            "term": "Tapón rojo o amarillo",
            "translation": "Sin anticoagulante (con o sin gel) → suero para química y serología."
          },
          {
            "term": "Tapón gris",
            "translation": "Fluoruro de sodio → glucosa (evita que las células la consuman)."
          }
        ],
        "grammar_note": "El color del tapón indica el aditivo que trae el tubo."
      },
      "exercises": [
