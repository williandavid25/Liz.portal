        "vocabulary": [
          {
            "term": "Plasma",
            "translation": "Parte líquida de la sangre con anticoagulante. Conserva el fibrinógeno."
          },
          {
            "term": "Suero",
            "translation": "Líquido que queda después de que la sangre coagula. No tiene fibrinógeno."
          },
          {
            "term": "Anticoagulante",
            "translation": "Sustancia que impide que la sangre coagule (EDTA, citrato, heparina)."
          },
          {
            "term": "Centrifugar",
            "translation": "Girar la muestra a alta velocidad para separar las células del líquido."
          }
        ],
        "grammar_note": "Para obtener suero hay que esperar a que la sangre coagule antes de centrifugar."
      },
      "exercises": [
        {
          "type": "multiple_choice",
          "question": "¿Qué tiene el plasma que no tiene el suero?",
