      "title": "What time is it?",
      "subtitle": "La hora en inglés",
      "snoopy_tip": "Snoopy dice: 'Es hora de… ¡aprender!'",
      "xp_reward": 10,
      "hearts_cost_per_error": 1,
      "lesson": {
        "vocabulary": [
          {
            "term": "What time is it?",
            "translation": "¿Qué hora es?",
            "example_en": "Excuse me, what time is it?",
            "example_es": "Disculpe, ¿qué hora es?"
          },
          {
            "term": "It's seven o'clock",
            "translation": "Son las siete en punto",
            "example_en": "It's seven o'clock, time to work.",
            "example_es": "Son las siete en punto, hora de trabajar."
          },
          {
            "term": "Half past",
            "translation": "Y media",
            "example_en": "It's half past eight.",
            "example_es": "Son las ocho y media."
          },
          {
            "term": "Quarter to",
            "translation": "Menos cuarto",
            "example_en": "It's quarter to nine.",
            "example_es": "Son las nueve menos cuarto."
          }
        ],
        "grammar_note": "Para la hora se usa 'It's…'. 'O'clock' solo va con horas exactas."
      },
      "exercises": [
        {
          "type": "multiple_choice",
          "question": "¿Qué significa 'What time is it?'",
          "options": ["¿Qué día es hoy?", "¿Qué hora es?", "¿Cuánto cuesta?", "¿Dónde estás?"],
          "correct_index": 1
        },
        {
          "type": "fill_blank",
          "sentence": "It's seven ___, time to work.",
          "correct": "o'clock",
          "options": ["o'clock", "half", "quarter"]
        },
        {
          "type": "multiple_choice",
          "question": "'It's half past eight' es…",
          "options": ["8:00", "8:15", "8:30", "7:30"],
          "correct_index": 2,
          "explanation": "'Half past' significa 'y media'."
        },
        {
          "type": "word_match",
          "pairs": [
            ["O'clock", "En punto"],
            ["Half past", "Y media"],
            ["Quarter to", "Menos cuarto"],
            ["Quarter past", "Y cuarto"]
          ]
        },
        {
          "type": "word_order",
          "words": ["time", "What", "it", "is"],
          "correct": "What time is it",
          "translation": "¿Qué hora es?"
        }
      ]
    },
