{
  "name": "Liz",
  "short_name": "Liz",
  "description": "Una sorpresa mágica de cumpleaños con recuerdos y cartas.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#02020a",
  "theme_color": "#02020a",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/icons/liz-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/liz-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/liz-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/liz-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/compartir-sticker",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "imagenes",
          "accept": [
            "image/*",
            ".webp",
            ".png",
            ".gif",
            ".jpg",
            ".jpeg"
          ]
        }
      ]
    }
  }
}
